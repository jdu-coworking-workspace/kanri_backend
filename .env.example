# Nusxa: cp .env.example .env
# .env ni gitga commit qilmang.
#
# Domen: cowork.jdu.uz yoki portfolio.cowork.jdu.uz
# Qaysi biri bo'lsa, CORS_ORIGIN ni shu hostga qo'ying (path yo'q, slash yo'q).

APP_ENV=production
PORT=8000

# Faqat shu mashinadagi Postgres. 5432 ni internetga ochmang.
DATABASE_URL=postgresql+psycopg2://kanri:CHANGE_ME@127.0.0.1:5432/cowork_db
TEST_DATABASE_URL=

# openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

COOKIE_NAME=access_token
# Nginx + HTTPS dan keyin true. Sertifikat yo'q HTTP demo uchun false.
COOKIE_SECURE=true
# Bitta domen (https://domen/ va /api/) uchun lax. none qilmang.
COOKIE_SAMESITE=lax

# Brauzer ko'radigan aniq origin. Oxirida slash bo'lmasin.
CORS_ORIGIN=https://cowork.jdu.uz

# Productionda rasmlar doim S3 dan keladi.
# Lokal ishlab chiqishda S3_MODE=local qilsangiz backend/media/ ishlatiladi.
S3_MODE=production
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET_NAME=kanri-cowork-media

# EC2 da bo'sh qoldiring. boto3 kalitlarni instance role dan oladi.
# Faqat lokal mashinada S3 ni sinamoqchi bo'lsangiz to'ldiring.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
