[Unit]
Description=Kanri Cowork API (FastAPI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=kanri
Group=kanri
WorkingDirectory=/var/www/kanri/backend
# journalctl loglari kechikmasligi uchun.
Environment=PYTHONUNBUFFERED=1
# .env ni pydantic o'qiydi. Bu unit 8000 ni faqat localhostga bog'laydi.
# --proxy-headers ni olib tashlamang: HTTPS ortida 307 redirect Location
# sarlavhasi http:// bo'lib qoladi va login buziladi.
ExecStart=/var/www/kanri/backend/venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
